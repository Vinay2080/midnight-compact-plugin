{
  parserClass="dev.verloren.midnight.parser.CompactParser"
  psiPackage="dev.verloren.midnight.psi"
  psiImplPackage="dev.verloren.midnight.psi.impl"

  psiClassPrefix="Compact"
  psiImplClassSuffix="Impl"

  elementTypeHolderClass="dev.verloren.midnight.psi.CompactTypes"
  elementTypeClass="com.intellij.psi.tree.IElementType"
  tokenTypeClass="dev.verloren.midnight.lexer.CompactTokenType"

  // The generated CompactTypes interface (above) is the single source of
  // truth for every IElementType used by this grammar. Compact.flex must
  // return these exact constants (import dev.verloren.midnight.psi.CompactTypes)
  // rather than declaring its own - otherwise the generated parser's
  // reference-equality token checks will never match what the lexer emits.
  // Tokens listed below are documented here for traceability; their literal
  // text must stay in sync with the corresponding rules in Compact.flex.
  tokens = [
    PRAGMA           = "pragma"
    IMPORT           = "import"
    EXPORT           = "export"
    FROM             = "from"
    MODULE           = "module"
    PREFIX           = "prefix"
    ASSERT           = "assert"
    AS               = "as"
    CIRCUIT          = "circuit"
    CONST            = "const"
    CONSTRUCTOR      = "constructor"
    CONTRACT         = "contract"
    DEFAULT          = "default"
    DISCLOSE         = "disclose"
    ELSE             = "else"
    ENUM             = "enum"
    EXTERNAL         = "external"
    FOLD             = "fold"
    FOR              = "for"
    IF               = "if"
    IMPLEMENTS       = "implements"
    INCLUDE          = "include"
    LEDGER           = "ledger"
    MAP              = "map"
    NEW              = "new"
    OF               = "of"
    PAD              = "pad"
    PURE             = "pure"
    RETURN           = "return"
    SEALED           = "sealed"
    SLICE            = "slice"
    STRUCT           = "struct"
    TYPE             = "type"
    WITNESS          = "witness"
    EMIT             = "emit"
    TRUE             = "true"
    FALSE            = "false"
    ASSIGN           = "="
    PLUS_ASSIGN      = "+="
    MINUS_ASSIGN     = "-="
    PLUS             = "+"
    MINUS            = "-"
    STAR             = "*"
    EQEQ             = "=="
    NOTEQ            = "!="
    LT               = "<"
    LTE              = "<="
    GT               = ">"
    GTE              = ">="
    ARROW            = "=>"
    NOT              = "!"
    ANDAND           = "&&"
    OROR             = "||"
    RANGE            = ".."
    DOT              = "."
    SPREAD           = "..."
    QUESTION         = "?"
    COLON            = ":"
    LPAREN           = "("
    RPAREN           = ")"
    LBRACE           = "{"
    RBRACE           = "}"
    LBRACKET         = "["
    RBRACKET         = "]"
    COMMA            = ","
    SEMICOLON        = ";"
    HASH             = "#"
  ]
}

// ─── Top-level ───────────────────────────────────────────────────────────────
// Translated from: (Compact (program) [program :: src (K* program-element) eof => ...])
// `src` and `=> lambda` are semantic/AST artifacts — omitted.
// K* = zero-or-more; eof = EOF token.

root ::= program

program ::= program_element* EOF

// ─── Program elements ────────────────────────────────────────────────────────
// Translated from: (Program-element (program-element) [...])

program_element ::=
    pragma_form
  | module_definition
  | import_form
  | export_form
  | include_form
  | struct_declaration
  | enum_declaration
  | contract_declaration
  | implements_declaration
  | type_alias_declaration
  | ledger_declaration
  | external_declaration
  | witness_declaration
  | constructor_definition
  | circuit_definition

// ─── Forward references (not yet translated) ─────────────────────────────────

// ─── Stub rules (keep Grammar-Kit happy until productions are translated) ────

// ─── Pragma ──────────────────────────────────────────────────────────────────
// Translated from: (Pragma (pragma-form)
//   [pragma :: src (KEYWORD pragma) id version-expr #\; => ...])
// `src`, token-value checks, and lambda body are semantic artifacts — omitted.

pragma_form ::= PRAGMA IDENTIFIER version_expr SEMICOLON

// ─── Version expressions (operator-precedence chain) ─────────────────────────
// Translated from: (Version-expression (version-expr) ...)
// OR  binds loosest → handled at version_expr level
// AND binds tighter  → handled at version_expr0 level
// Prefix ops / atoms → handled at version_term / version_atom level

private version_expr ::= version_expr0 (OROR version_expr0)*

// Translated from: (Version-expression0 (version-expr0) ...)
private version_expr0 ::= version_term (ANDAND version_term)*

// Translated from: (Version-Term (version-term) ...)
version_term ::= version_atom                        // version-term-atom
               | NOT     version_atom                // version-term-not  (#\!)
               | LT      version_atom                // version-term-lt   (#\<)
               | LTE     version_atom                // version-term-le   ("<=")
               | GTE     version_atom                // version-term-ge   (">=")
               | GT      version_atom                // version-term-gt   (#\>)
               | LPAREN  version_expr  RPAREN        // version-term-parens

// TODO: translate version_atom (Version-Atom production not yet provided)
// version_atom handles bare nat and version literals.
version_atom ::= VERSION_LITERAL
               | DECIMAL_LITERAL

// ─── Include ─────────────────────────────────────────────────────────────────
// Translated from: (Include (include-form)
//   [include :: src (KEYWORD include) file #\; => ...])
// `file` is the `file` terminal → STRING_LITERAL in the lexer.

include_form ::= INCLUDE STRING_LITERAL SEMICOLON

// ─── Module definition ───────────────────────────────────────────────────────
// Translated from: (Module-definition (module-definition)
//   [module-definition :: src (OPT (KEYWORD export) #f) (KEYWORD module)
//                         module-name (OPT gparams #f) #\{ (K* program-element) #\} => ...])
// OPT x #f  → x?    (optional, defaulting to false/absent)
// K*        → *     (zero-or-more)
// module-name is the `module-name` terminal → IDENTIFIER in the lexer.

module_definition ::= EXPORT? MODULE IDENTIFIER gparams? LBRACE program_element* RBRACE

// ─── Generic parameter list ───────────────────────────────────────────────────
// Translated from: (Generic-parameter-list (gparams)
//   [generic-param-list :: #\< (SEP* generic-param #\, #t) #\> => ...])
// SEP* x #\, #t → (x (COMMA x)* COMMA?)?  — zero-or-more comma-separated,
//                  trailing comma allowed (#t), whole list may be empty.

gparams ::= LT (generic_param (COMMA generic_param)* COMMA?)? GT

// ─── Generic parameter ────────────────────────────────────────────────────────
// Translated from: (Generic-parameter (generic-param)
//   [generic-param-nat  :: src #\# tvar-name => ...]   → HASH IDENTIFIER
//   [generic-param-type :: src tvar-name => ...]        → IDENTIFIER
// tvar-name is the `tvar-name` terminal → IDENTIFIER in the lexer.

generic_param ::= HASH IDENTIFIER   // generic-param-nat  (#-prefixed, nat-valued type variable)
               | IDENTIFIER         // generic-param-type (type-valued type variable)

// ─── Import declaration ─────────────────────────────────────────────────────
// Translated from: (Import-declaration (import-form)
//   [import-declaration :: src (KEYWORD import)
//                          (OPT import-selection #f)
//                          import-name
//                          (OPT gargs #f)
//                          (OPT import-prefix #f)
//                          #\; => ...])
// OPT x #f → x?   import-selection comes BEFORE import-name per source order.

import_form ::= IMPORT import_selection? import_name gargs? import_prefix? SEMICOLON

// Translated from: (Import-selection (import-selection)
//   [import-selection :: #\{ (SEP* import-element #\, #t) #\} (KEYWORD from) => ...])
// SEP* with trailing (#t) → (import_element (COMMA import_element)* COMMA?)?
// Note: KEYWORD from follows the closing brace — it is part of this rule.

import_selection ::= LBRACE (import_element (COMMA import_element)* COMMA?)? RBRACE FROM

// Translated from: (Import-element (import-element)
//   [import-element-name   :: src id => ...]           → bare identifier
//   [import-element-rename :: src id (KEYWORD as) id => ...] → renamed import
// Longer alternative first to avoid Grammar-Kit's first-match ambiguity.

import_element ::= IDENTIFIER AS IDENTIFIER   // import-element-rename
                 | IDENTIFIER                 // import-element-name

// Translated from: (Import-name (import-name)
//   [import-name-id   :: id   => values]   → IDENTIFIER
//   [import-name-file :: file => values]   → STRING_LITERAL

import_name ::= STRING_LITERAL   // import-name-file  (quoted path)
              | IDENTIFIER       // import-name-id    (bare module name)

// Translated from: (Import-prefix (import-prefix)
//   [import-prefix :: (KEYWORD prefix) id => ...])

import_prefix ::= PREFIX IDENTIFIER

// ─── Generic argument list ────────────────────────────────────────────────────
// Translated from: (Generic-argument-list (gargs)
//   [generic-args :: #\< (SEP* garg #\, #t) #\> => ...])
// SEP* with trailing (#t) → (garg (COMMA garg)* COMMA?)?

gargs ::= LT (garg (COMMA garg)* COMMA?)? GT

// Translated from: (Generic-argument (garg)
//   [generic-argument-size :: src nat  => ...]  → nat_literal
//   [generic-argument-type :: src type => ...]  → type
// nat_literal alternative first: a bare decimal could match either,
// but nat_literal is more specific so it wins under first-match.

garg ::= nat_literal   // generic-argument-size
       | type_expression          // generic-argument-type

// ─── Export declaration ──────────────────────────────────────────────────────────
// Translated from: (Export-declaration (export-form)
//   [export-declaration :: src (KEYWORD export) #\{
//                          (SEP* id #\, #t) #\} (OPT #\; #f) => ...])
// SEP* id #\, #t → (IDENTIFIER (COMMA IDENTIFIER)* COMMA?)? — ids directly, no wrapper node.
// OPT #\; #f     → SEMICOLON?  (trailing semicolon is optional).

export_form ::= EXPORT LBRACE (IDENTIFIER (COMMA IDENTIFIER)* COMMA?)? RBRACE SEMICOLON?


// ─── Structure declaration ─────────────────────────────────────────────────────────
// Translated from: (Structure-declaration (struct-declaration))
// Two alternatives share identical structure, differing only in field separator.
//   structure-declaration/semicolons: SEP* typed-id #\; #t
//   structure-declaration/commas:     SEP* typed-id #\, #t
// SEP* x sep #t → (x (sep x)* sep?)?   (zero-or-more, trailing allowed, whole group optional)
// struct-name → IDENTIFIER;  OPT x #f → x?
// typed-id is not yet translated — see stub at bottom of file.

struct_declaration ::=
    EXPORT? STRUCT IDENTIFIER gparams? LBRACE (typed_id (SEMICOLON typed_id)* SEMICOLON?)? RBRACE SEMICOLON?   // structure-declaration/semicolons
  | EXPORT? STRUCT IDENTIFIER gparams? LBRACE (typed_id (COMMA    typed_id)* COMMA?   )? RBRACE SEMICOLON?   // structure-declaration/commas

// ─── Enum declaration ──────────────────────────────────────────────────────────────
// Translated from: (Enum-declaration (enum-declaration)
//   [enum-declaration :: src (OPT (KEYWORD export) #f) (KEYWORD enum) enum-name
//                        #\{ (SEP+ id #\, #t) #\} (OPT #\; #f) => ...])
// SEP+ → one-or-more: IDENTIFIER (COMMA IDENTIFIER)* COMMA?
// enum-name → IDENTIFIER

enum_declaration ::= EXPORT? ENUM IDENTIFIER LBRACE IDENTIFIER (COMMA IDENTIFIER)* COMMA? RBRACE SEMICOLON?

// ─── External contract declaration ──────────────────────────────────────────────
// Translated from: (External-contract-declaration (contract-declaration))
// Two alternatives share identical structure, differing only in member separator.
//   contract-declaration/semicolons: SEP* circuit-declaration #\; #t
//   contract-declaration/commas:     SEP* circuit-declaration #\, #t
// circuit-declaration here refers to (External-contract-circuit (circuit-declaration) ...)
// i.e. external_contract_circuit, NOT the top-level circuit_definition.
// contract-name → IDENTIFIER;  OPT x #f → x?

contract_declaration ::=
    EXPORT? CONTRACT IDENTIFIER LBRACE (external_contract_circuit (SEMICOLON external_contract_circuit)* SEMICOLON?)? RBRACE SEMICOLON?   // contract-declaration/semicolons
  | EXPORT? CONTRACT IDENTIFIER LBRACE (external_contract_circuit (COMMA    external_contract_circuit)* COMMA?   )? RBRACE SEMICOLON?   // contract-declaration/commas

// ─── External contract circuit ────────────────────────────────────────────────
// Translated from: (External-contract-circuit (circuit-declaration)
//   [external-contract-circuit :: src (OPT (KEYWORD pure) #f) (KEYWORD circuit)
//                                     id simple-parameter-list #\: type => ...])
// No semicolon — separator is handled by the enclosing contract_declaration rule.

external_contract_circuit ::= PURE? CIRCUIT IDENTIFIER simple_parameter_list COLON type_expression

// ─── Contract-implements declaration ──────────────────────────────────────────────
// Translated from: (Contract-Implements-declaration (implements-declaration)
//   [contract-implements-declaration :: src (KEYWORD contract)
//                                        (KEYWORD implements) type #\; => ...])

implements_declaration ::= CONTRACT IMPLEMENTS type_expression SEMICOLON

// ─── Type alias declaration ──────────────────────────────────────────────────────────
// Translated from: (Type-declaration (type-alias-declaration)
//   [type-declaration :: src
//                        (OPT (KEYWORD export) #f)
//                        (OPT (KEYWORD new) #f)
//                        (KEYWORD type) type-name
//                        (OPT gparams #f) #\= type #\; => ...])
// type-name → IDENTIFIER;  #\= → ASSIGN;  OPT (KEYWORD new) #f → NEW?

type_alias_declaration ::= EXPORT? NEW? TYPE IDENTIFIER gparams? ASSIGN type_expression SEMICOLON

// ─── Ledger declaration ────────────────────────────────────────────────────────
// Translated from: (Ledger-declaration (ledger-declaration)
//   [public-ledger-declaration :: src
//                                 (OPT (KEYWORD export) #f)
//                                 (OPT (KEYWORD sealed) #f)
//                                 (KEYWORD ledger) id #\: type #\; => ...])

ledger_declaration ::= EXPORT? SEALED? LEDGER IDENTIFIER COLON type_expression SEMICOLON

// ─── External declaration ─────────────────────────────────────────────────────
// Translated from Lsrc.json: (External-Declaration (edecl)
//   [external :: src exported? function-name (type-param* ...) (arg* ...) type])
// The source grammar represents this as `external` with optional export,
// generic parameters, a simple argument list, and a required return type.

external_declaration ::= EXPORT? EXTERNAL IDENTIFIER gparams? simple_parameter_list COLON type_expression SEMICOLON

// ─── Witness declaration ────────────────────────────────────────────────────────
// Translated from: (Witness-declaration (witness-declaration)
//   [witness-declaration :: src
//                           (OPT (KEYWORD export) #f)
//                           (KEYWORD witness) id
//                           (OPT gparams #f)
//                           simple-parameter-list #\: type #\; => ...])
// simple-parameter-list → simple_parameter_list (not yet translated — see stub below).

witness_declaration ::= EXPORT? WITNESS IDENTIFIER gparams? simple_parameter_list COLON type_expression SEMICOLON

// ─── Constructor definition ───────────────────────────────────────────────────────
// Translated from: (Constructor (constructor-definition)
//   [ledger-constructor :: src (KEYWORD constructor) pattern-parameter-list block => ...])
// pattern-parameter-list → pattern_parameter_list (not yet translated — see stub below).

constructor_definition ::= CONSTRUCTOR pattern_parameter_list block

// ─── Circuit definition ──────────────────────────────────────────────────────────
// Translated from: (Circuit-definition (circuit-definition)
//   [circuit-definition :: src
//                          (OPT (KEYWORD export) #f)
//                          (OPT (KEYWORD pure) #f)
//                          (KEYWORD circuit) function-name
//                          (OPT gparams #f)
//                          pattern-parameter-list #\: type block => ...])
// function-name terminal → IDENTIFIER in the lexer.
// Return type is `#\: type` (not optional — no OPT wrapper in source).

circuit_definition ::= EXPORT? PURE? CIRCUIT IDENTIFIER gparams? pattern_parameter_list COLON type_expression block

// ─── Typed identifier ──────────────────────────────────────────────────────────────
// Translated from: (Typed-identifier (typed-id)
//   [typed-id :: src id #\: type => ...])

typed_id ::= IDENTIFIER COLON type_expression

// ─── Simple parameter list ─────────────────────────────────────────────────────
// Translated from: (Simple-parameter-list (simple-parameter-list)
//   [parameter-list :: #\( (SEP* typed-id #\, #t) #\) => ...])
// SEP* typed-id #\, #t → (typed_id (COMMA typed_id)* COMMA?)?

simple_parameter_list ::= LPAREN (typed_id (COMMA typed_id)* COMMA?)? RPAREN

// ─── Typed pattern ───────────────────────────────────────────────────────────────
// Translated from: (Typed-pattern (typed-pattern)
//   [typed-pattern :: src pattern #\: type => ...])
// `pattern` is now translated — see below.

typed_pattern ::= pattern COLON type_expression

// ─── Pattern ──────────────────────────────────────────────────────────────────
// Translated from: (Pattern (pattern)
//   [pattern-id     :: id => values]
//   [pattern-tuple  :: src #\[ (SEP* (OPT pattern #f) #\, #t) #\] => ...]
//   [pattern-struct :: src #\{ (SEP* pattern-struct-elt #\, #t) #\} => ...])
//
// pattern-tuple: SEP* (OPT pattern #f) #\, #t
//   Each element is individually optional (OPT pattern #f) — allows
//   hole/wildcard slots such as [, x, ].  Expressed as `pattern?` per slot.
//   SEP* … #t → whole list is optional, trailing comma allowed.

pattern ::=
    IDENTIFIER                                                    // pattern-id
  | LBRACKET (pattern? (COMMA pattern?)* COMMA?)? RBRACKET        // pattern-tuple  (OPT per slot)
  | LBRACE (pattern_struct_elt (COMMA pattern_struct_elt)* COMMA?)? RBRACE   // pattern-struct

// ─── Pattern struct element ─────────────────────────────────────────────────────
// Translated from: (Pattern-struct-element (pattern-struct-elt)
//   [pattern-struct-elt-id      :: id => values]
//   [pattern-struct-elt-pattern :: id #\: pattern => ...])
// Longer alternative first to avoid first-match ambiguity with bare id.

pattern_struct_elt ::=
    IDENTIFIER COLON pattern   // pattern-struct-elt-pattern
  | IDENTIFIER                 // pattern-struct-elt-id

// ─── Pattern parameter list ───────────────────────────────────────────────────────
// Translated from: (Pattern-parameter-list (pattern-parameter-list)
//   [pattern-parameter-list :: #\( (SEP* typed-pattern #\, #t) #\) => ...])
// SEP* typed-pattern #\, #t → (typed_pattern (COMMA typed_pattern)* COMMA?)?

pattern_parameter_list ::= LPAREN (typed_pattern (COMMA typed_pattern)* COMMA?)? RPAREN

// ─── Shared sub-rules ────────────────────────────────────────────────────────

//parameter_list       ::= LPAREN parameter_list_inner? RPAREN
//
//parameter_list_inner ::= parameter (COMMA parameter)* COMMA?
//
//parameter            ::= IDENTIFIER COLON type

return_type          ::= COLON type_expression

// ─── Types ─────────────────────────────────────────────────────────────────────────────
// Translated from: (Type (type) [...])
// All 12 alternatives in source order.

type_expression ::=
    tref                                                    // type-ref
  | BOOLEAN_TYPE                                            // type-boolean
  | FIELD_TYPE                                              // type-field
  | JUBJUB_SCALAR_TYPE                                      // type-jubjub-scalar
  | SECP256K1_BASE_TYPE                                     // type-secp256k1-base
  | SECP256K1_SCALAR_TYPE                                   // type-secp256k1-scalar
  | UINT_TYPE  LT tsize RANGE tsize GT                      // type-unsigned-integer-max  ("..") — longer, try first
  | UINT_TYPE  LT tsize GT                                  // type-unsigned-integer-bits
  | BYTES_TYPE LT tsize GT                                  // type-bytes
  | OPAQUE_TYPE LT STRING_LITERAL GT                        // type-opaque  (str terminal → STRING_LITERAL)
  | VECTOR_TYPE LT tsize COMMA type_expression GT                      // type-vector
  | LBRACKET (type_expression (COMMA type_expression)* COMMA?)? RBRACKET          // type-tuple

// ─── Type reference ─────────────────────────────────────────────────────────────────
// Translated from: (Type-reference (tref)
//   [type-ref :: src id (OPT gargs #f) => ...])

tref ::= IDENTIFIER gargs?

// ─── Type size ────────────────────────────────────────────────────────────────────────
// Translated from: (Type-size (tsize start end)
//   [type-size-field    :: src nat => ...]  → DECIMAL_LITERAL  (nat terminal)
//   [type-size-type-ref :: src id  => ...]  → IDENTIFIER       (id terminal)
// Used inside Uint<...>, Bytes<...>, Vector<...> to express size constraints.

tsize ::= DECIMAL_LITERAL   // type-size-field    (a literal field count / bit width)
        | IDENTIFIER        // type-size-type-ref (a type-variable size)

// ─── Literals (nat_literal kept for any remaining internal uses) ─────────────────

private nat_literal ::= DECIMAL_LITERAL

// ─── Block ───────────────────────────────────────────────────────────────────
// Translated from: (Block (block)
//   [block :: src #\{ (K* stmt) #\} => ...])
// K* stmt → stmt*

block ::= LBRACE stmt* RBRACE

// ─── Statement ───────────────────────────────────────────────────────────────
// Translated from: (Statement (stmt)
//   [statement-one-armed-if :: src (KEYWORD if) #\( expr-seq #\) stmt => ...]
//   [#f :: stmt0 => values])
// One-armed if is tried first; stmt0 is the fallthrough alternative.
// NOTE: the consequent of one-armed-if is `stmt` (can nest), while two-armed
// if (in stmt0) uses `stmt0` for its consequent — this resolves dangling-else.

stmt ::= IF LPAREN expr_seq RPAREN stmt   // statement-one-armed-if
       | stmt0                            // fallthrough

// ─── Statement0 ──────────────────────────────────────────────────────────────
// Translated from: (Statement0 (stmt0) [...])
// All 8 alternatives in source order.
// IMPORTANT: statement-for1 (tsize RANGE tsize) must come before statement-for2
// (expr_seq) so the range form is tried first.
// IMPORTANT: statement-return-no-value (RETURN SEMICOLON) is placed before
// statement-return-value (RETURN expr_seq SEMICOLON) to avoid consuming the
// semicolon as the start of an expr_seq in first-match PEG parsing.

stmt0 ::=
    CONST cbinding (COMMA cbinding)* SEMICOLON                       // statement-const     (SEP+ #f = no trailing comma)
  | IF LPAREN expr_seq RPAREN stmt0 ELSE stmt                        // statement-if        (two-armed; consequent is stmt0)
  | FOR LPAREN CONST IDENTIFIER OF tsize RANGE tsize RPAREN stmt     // statement-for1      (range form: start..end)
  | FOR LPAREN CONST IDENTIFIER OF expr_seq RPAREN stmt              // statement-for2      (iterable form)
  | RETURN SEMICOLON                                                  // statement-return-no-value
  | RETURN expr_seq SEMICOLON                                         // statement-return-value
  | block                                                             // statement-block
  | expr_seq SEMICOLON                                                // statement-expr      (last: most general)

// ─── Expression sequence ─────────────────────────────────────────────────────
// Translated from: (Expression-sequence (expr-seq)
//   [expr-seq-one  :: expr => values]
//   [expr-seq-many :: src (SEP+ expr #\,) #\, expr => ...])
// expr-seq-many: (SEP+ expr #\,) consumes ≥1 exprs, then one more #\, expr.
// Net result: expr (COMMA expr)+ = two-or-more comma-separated exprs.
// Placed first (more specific) so the single-expr fallthrough comes after.

expr_seq ::= expr (COMMA expr)+   // expr-seq-many  (≥ 2 expressions)
           | expr                  // expr-seq-one   (single expression)

// ─── Expression ──────────────────────────────────────────────────────────────
// Translated from: (Expression (expr) [...])
// Right-operand of ternary/assignment is `expr` (right-associative).
// `expr0` alternatives are tried after the right-recursive forms.
// NOTE: conditional (ternary) placed before assignment to avoid ambiguity
// when the middle branch itself is an assignment expression.

expr ::=
    expr0 QUESTION expr COLON expr   // conditional expression  (ternary)
  | expr0 ASSIGN      expr           // assignment expression   (=)
  | expr0 PLUS_ASSIGN expr           // increment expression    (+=)
  | expr0 MINUS_ASSIGN expr          // decrement expression    (-=)
  | expr0                            // fallthrough

// ─── Expression0: || ─────────────────────────────────────────────────────────
// Translated from: (Expression0 (expr0) [...])

private expr0 ::= expr1 (OROR expr1)*

// ─── Expression1: && ─────────────────────────────────────────────────────────
// Translated from: (Expression1 (expr1) [...])

private expr1 ::= expr2 (ANDAND expr2)*

// ─── Expression2: == != ──────────────────────────────────────────────────────
// Translated from: (Expression2 (expr2) [...])

private expr2 ::= expr3 ((EQEQ | NOTEQ) expr3)*

// ─── Expression3: < <= >= > ──────────────────────────────────────────────────
// Translated from: (Expression3 (expr3) [...])
// NOTE: both sides are `expr4` (NOT `expr3`) — comparisons are intentionally
// non-associative in Compact (chaining `a < b < c` does not parse).

expr3 ::= expr4 LT  expr4   // <  expression  (non-associative)
        | expr4 LTE expr4   // <= expression  (non-associative)
        | expr4 GTE expr4   // >= expression  (non-associative)
        | expr4 GT  expr4   // >  expression  (non-associative)
        | expr4              // fallthrough

// ─── Expression4: cast ───────────────────────────────────────────────────────
// Translated from: (Expression4 (expr4) [...])

private expr4 ::= expr5 (AS type_expression)*
// ─── Forward-reference stubs ─────────────────────────────────────────────────
// ─── Expression5: + - ────────────────────────────────────────────────────────
// Translated from: (Expression5 (expr5) [...])

private expr5 ::= expr6 ((PLUS | MINUS) expr6)*

// ─── Expression6: * ──────────────────────────────────────────────────────────
// Translated from: (Expression6 (expr6) [...])

private expr6 ::= expr7 (STAR expr7)*

// ─── Expression7: ! ──────────────────────────────────────────────────────────
// Translated from: (Expression7 (expr7) [...])

expr7 ::= NOT expr7           // not expression (!)
        | expr8               // fallthrough

// ─── Expression8: Member and index ───────────────────────────────────────────
// Translated from: (Expression8 (expr8) [...])

expr8 ::= expr8 LBRACKET expr RBRACKET                                // tuple/vector reference  (expr[expr])
        | expr8 DOT IDENTIFIER                                        // element reference       (expr.id)
        | expr8 DOT IDENTIFIER LPAREN (expr (COMMA expr)* COMMA?)? RPAREN   // element call            (expr.id(expr, ...))
        | expr9                                                       // fallthrough

// ─── Expression9: Call ───────────────────────────────────────────────────────
// Translated from: (Expression9 (expr9) [...])

expr9 ::= fun LPAREN (expr (COMMA expr)* COMMA?)? RPAREN              // term-call               (fun(expr, ...))
        | expr10                                                      // fallthrough

// ─── Expression10 ────────────────────────────────────────────────────────────
// Translated from: (Expression10 (expr10) [...])
// Contains many term-level builtins and fallthrough to `term`.
// `term-fold` uses two comma-separated exprs followed by a SEP+.
// `term-struct` uses `tref`, not `expr`.
// `term-bytes` uses `tuple_arg` (in source `bytes-arg` which maps to the same helper).

expr10 ::= MAP LPAREN fun COMMA expr (COMMA expr)* COMMA? RPAREN                        // term-map
         | FOLD LPAREN fun COMMA expr COMMA expr (COMMA expr)* COMMA? RPAREN            // term-fold
         | SLICE LT tsize GT LPAREN expr COMMA expr RPAREN                              // term-slice
         | LBRACKET (tuple_arg (COMMA tuple_arg)* COMMA?)? RBRACKET                     // term-tuple
         | BYTES_TYPE LBRACKET (tuple_arg (COMMA tuple_arg)* COMMA?)? RBRACKET          // term-bytes
         | tref LBRACE (struct_arg (COMMA struct_arg)* COMMA?)? RBRACE                  // term-struct
         | ASSERT LPAREN expr COMMA STRING_LITERAL RPAREN                               // term-assert
         | EMIT LPAREN expr RPAREN                                                      // term-emit
         | DISCLOSE LPAREN expr RPAREN                                                  // term-disclose
         | term                                                                         // fallthrough

// ─── Term ────────────────────────────────────────────────────────────────────
// Translated from: (Term (term) [...])
// All base cases: variables, literals, parenthesis.
// term-element-field is nat -> DECIMAL_LITERAL. Hex/Binary/Octal kept from old stub for safety.

term ::= IDENTIFIER                                                    // term-ref
       | TRUE                                                          // term-true
       | FALSE                                                         // term-false
       | DECIMAL_LITERAL                                               // term-element-field
       | HEX_LITERAL
       | BINARY_LITERAL
       | OCTAL_LITERAL
       | STRING_LITERAL                                                // term-element-string
       | PAD LPAREN DECIMAL_LITERAL COMMA STRING_LITERAL RPAREN        // term-element-padded-string
       | DEFAULT LT type_expression GT                                            // term-element-default
       | LPAREN expr_seq RPAREN                                        // term-parenthesized

// ─── Tuple and Structure arguments ───────────────────────────────────────────
// Translated from: (Tuple-argument) and (Structure-argument).
// SPREAD is "..." from Lexer.
// In struct_arg, named `IDENTIFIER COLON expr` is placed first to avoid
// first-match consumption by positional `expr` (which can be just an IDENTIFIER).

tuple_arg ::= SPREAD expr                                              // tuple-arg-spread
            | expr                                                     // tuple-arg-expression

struct_arg ::= IDENTIFIER COLON expr                                   // struct-arg-named
             | SPREAD expr                                             // struct-arg-spread
             | expr                                                    // struct-arg-positional

// ─── Function ──────────────────────────────────────────────────────────────────
// Translated from: (Function (fun) [...])
// Arrow syntax uses the ARROW terminal (=>).
// block and expr alternatives map to arrow-block and arrow-expr.

fun ::= IDENTIFIER gargs?                                                       // function-ref
      | arrow_parameter_list return_type? ARROW block                           // function-arrow-block
      | arrow_parameter_list return_type? ARROW expr                            // function-arrow-expr
      | LPAREN fun RPAREN                                                       // parenthesized-function

// ─── Optionally typed pattern ────────────────────────────────────────────────
// Translated from: (Optionally-typed-pattern (optionally-typed-pattern) [...])
// typed_pattern must come first to avoid first-match ambiguity with `pattern`
// (which can start with a bare identifier).

optionally_typed_pattern ::= typed_pattern | pattern

// ─── Const binding ───────────────────────────────────────────────────────────
// Translated from: (Const-Binding (cbinding) [...])

cbinding ::= optionally_typed_pattern ASSIGN expr

// ─── Arrow parameter list ────────────────────────────────────────────────────
// Translated from: (Arrow-parameter-list (arrow-parameter-list) [...])

arrow_parameter_list ::= LPAREN (optionally_typed_pattern (COMMA optionally_typed_pattern)* COMMA?)? RPAREN