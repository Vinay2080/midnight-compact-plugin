#* @vtlvariable name="NAME" type="java.lang.String" *#
pragma language_version >= 0.20.0;

export module ${NAME} {
  export struct Config {
    enabled: Boolean,
    threshold: Uint<32>
  }

  export pure circuit isValid(threshold: Uint<32>, value: Uint<32>): Boolean {
    return value >= threshold;
  }
}
