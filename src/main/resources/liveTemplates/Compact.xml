<templateSet group="Compact">
    <template name="cct"
              value="contract $NAME$ {&#10;  circuit $CIRCUIT$(): Void;&#10;}&#10;&#10;export ledger $STATE$: $TYPE$;&#10;&#10;constructor() {&#10;  $INIT$&#10;}&#10;&#10;export circuit $CIRCUIT$(): Void {&#10;  $END$&#10;}"
              toReformat="true"
              toShortenFQNames="true" key="live.template.cct.description" resource-bundle="messages.MyMessageBundle">
        <variable name="NAME" expression="compactDeclarationName(&quot;contract&quot;)" defaultValue="" alwaysStopAt="true"/>
        <variable name="CIRCUIT" expression="compactDeclarationName(&quot;circuit&quot;)" defaultValue="" alwaysStopAt="true"/>
        <variable name="STATE" expression="compactDeclarationName(&quot;ledger&quot;)" defaultValue="" alwaysStopAt="true"/>
        <variable name="TYPE" expression="compactType(&quot;Counter&quot;)" defaultValue="" alwaysStopAt="true"/>
        <variable name="INIT" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="COMPACT_CODE" value="true"/>
        </context>
    </template>

    <template name="ccti"
