        <variable name="NAME" expression="compactDeclarationName(&quot;contract&quot;)" defaultValue="" alwaysStopAt="true"/>
        <variable name="CIRCUIT" expression="compactDeclarationName(&quot;circuit&quot;)" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="COMPACT_CODE" value="true"/>
        </context>
    </template>

