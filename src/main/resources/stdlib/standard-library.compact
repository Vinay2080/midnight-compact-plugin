/**
 * @module CompactStandardLibrary
 *
 * Midnight Compact Standard Library
 *
 * Provides core zero-knowledge utility types (`Maybe<T>`, `Either<A, B>`),
 * Merkle tree traversal and root calculation, cryptographic commitments,
 * and Midnight kernel shielded token operations.
 */

/**
 * Global Midnight runtime kernel interface exposing state, cryptographic assertions,
 * and shielded token operations.
 */
export ledger kernel: Kernel;

// =========================================================================
// Generic Data
// =========================================================================

/**
 * An optional value representation.
 *
 * @param is_some True if a value is present, false otherwise.
 * @param value The encapsulated value if present, or default<T> if absent.
 */
export struct Maybe<T> {
  is_some: Boolean;
  value: T;
}

/**
 * Wraps a value in a `Maybe<T>` container with `is_some = true`.
 *
 * @param value The value to wrap.
 * @return A `Maybe<T>` instance containing `value`.
 */
export circuit some<T>(value: T): Maybe<T> {
  return Maybe<T>{ is_some: true, value: value };
}

/**
 * Creates an empty `Maybe<T>` container with `is_some = false`.
 *
 * @return An empty `Maybe<T>` instance containing `default<T>`.
 */
export circuit none<T>(): Maybe<T> {
  return Maybe<T>{ is_some: false, value: default<T> };
}

/**
 * A disjoint union of two types `A` and `B`.
 *
 * @param is_left True if holding the left variant `A`, false if holding `B`.
 * @param left The left value if `is_left` is true.
 * @param right The right value if `is_left` is false.
 */
export struct Either<A, B> {
  is_left: Boolean;
  left: A;
  right: B;
}

/**
 * Constructs a left-variant instance of `Either<A, B>`.
 *
 * @param value The left value.
 * @return An `Either<A, B>` holding `value` on the left.
 */
export circuit left<A, B>(value: A): Either<A, B> {
  return Either<A, B>{ is_left: true, left: value, right: default<B> };
}

/**
 * Constructs a right-variant instance of `Either<A, B>`.
 *
 * @param value The right value.
 * @return An `Either<A, B>` holding `value` on the right.
 */
export circuit right<A, B>(value: B): Either<A, B> {
  return Either<A, B>{ is_left: false, left: default<A>, right: value };
}

// =========================================================================
// Merkle trees
// =========================================================================

/**
 * Represents a Merkle tree root or node hash digest in the Midnight native field.
 *
 * @param field The 254-bit elliptic curve scalar field element representing the digest.
 */
export struct MerkleTreeDigest { field: Field; }

/**
 * A single hop along a Merkle tree authentication path.
 *
 * @param sibling The digest of the sibling subtree.
 * @param goes_left True if traversal moves left towards the leaf, false if right.
 */
export struct MerkleTreePathEntry {
  sibling: MerkleTreeDigest;
  goes_left: Boolean;
}

/**
 * Complete Merkle membership proof path for a leaf value.
 *
 * @param leaf The leaf data committed in the Merkle tree.
 * @param path Vector of Merkle path entries from leaf to root.
 */
export struct MerkleTreePath<#n, T> {
  leaf: T;
  path: Vector<n, MerkleTreePathEntry>;
}

struct LeafPreimage<T> {
  domain_sep: Bytes<6>,
  data: T,
}

/**
 * Computes the root digest from a leaf preimage and its Merkle authentication path.
 *
 * @param path The Merkle path containing the leaf and sibling path entries.
 * @return The calculated root `MerkleTreeDigest`.
 */
export circuit merkleTreePathRoot<#n, T>(path: MerkleTreePath<n, T>): MerkleTreeDigest {
  return MerkleTreeDigest{
           field: fold(merkleTreePathEntryRoot,
                       degradeToTransient(persistentHash<LeafPreimage<T>>(LeafPreimage<T>{ domain_sep: "mdn:lh", data: path.leaf })),
                       path.path)
          };
}

/**
 * Computes the root digest from a pre-hashed leaf digest and its Merkle authentication path.
 *
 * @param path The Merkle path containing the raw leaf hash and sibling path entries.
 * @return The calculated root `MerkleTreeDigest`.
 */
export circuit merkleTreePathRootNoLeafHash<#n>(path: MerkleTreePath<n, Bytes<32>>): MerkleTreeDigest {
  return MerkleTreeDigest{
           field: fold(merkleTreePathEntryRoot,
                       degradeToTransient(path.leaf),
                       path.path)
         };
}

/**
 * Combines an accumulator digest with a Merkle path entry using transient hashing.
 *
 * @param recursiveDigest Running digest from prior path hops.
 * @param entry Current sibling entry and traversal direction.
 * @return Next field element digest.
 */
circuit merkleTreePathEntryRoot(
  recursiveDigest: Field,
  entry: MerkleTreePathEntry
): Field {
  const left = entry.goes_left ? recursiveDigest : entry.sibling.field;
  const right = entry.goes_left ? entry.sibling.field : recursiveDigest;
  return transientHash<Vector<2, Field>>([left, right]);
}

// =========================================================================
// Midnight kernel types
// =========================================================================

/**
 * Cryptographic 32-byte identifier for a deployed Midnight smart contract.
 *
 * @param bytes 32-byte hash identifying the contract instance on the ledger.
 */
export struct ContractAddress { bytes: Bytes<32>; }

/**
 * Private coin state for Midnight shielded transactions.
 *
 * @param nonce Unique random scalar differentiating coin instances.
 * @param color 32-byte token identifier differentiating asset types.
 * @param value The amount of units held in the shielded coin.
 */
export struct ShieldedCoinInfo {
  nonce: Bytes<32>;
  color: Bytes<32>;
  value: Uint<128>;
}

/**
 * Shielded coin info accompanied by its position in the Merkle commitment tree.
 *
 * @param nonce Unique random scalar differentiating coin instances.
 * @param color 32-byte token identifier.
 * @param value The amount of units held in the coin.
 * @param mt_index Leaf index in the ledger state Merkle tree.
 */
export struct QualifiedShieldedCoinInfo {
  nonce: Bytes<32>;
  color: Bytes<32>;
  value: Uint<128>;
  mt_index: Uint<64>;
}

/**
 * Public key for receiving zero-knowledge shielded coins via the Zswap swap protocol.
 *
 * @param bytes 32-byte public key representation.
 */
export struct ZswapCoinPublicKey { bytes: Bytes<32>; }

/**
 * Outcome of a shielded coin transfer or split operation.
 *
 * @param change Optional change coin created and returned to the sender.
 * @param sent The newly minted shielded coin transferred to the recipient.
 */
export struct ShieldedSendResult {
  change: Maybe<ShieldedCoinInfo>;
  sent: ShieldedCoinInfo;
}

/**
 * Returns the native DUST asset color identifier (32 zero bytes).
 *
 * @return 32-byte identifier for the native token.
 */
export circuit nativeToken(): Bytes<32> {
  return pad(32, "") as Bytes<32>;
}

// =========================================================================
// Midnight helper circuits
// =========================================================================

/**
 * Derives a deterministic token type identifier from a contract address and domain separator.
 *
 * @param domain_sep Domain separation tag for the token type.
 * @param contractAddress Contract generating the token.
 * @return Derived 32-byte color identifier.
 */
export circuit tokenType(domain_sep: Bytes<32>, contractAddress: ContractAddress): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>([domain_sep, contractAddress.bytes], pad(32, "midnight:derive_token"));
}

/**
 * Mints a new shielded token coin into the ledger Zswap commitment tree.
 *
 * @param domain_sep Domain separator tag for the token asset class.
 * @param value Amount to mint.
 * @param nonce Unique randomness for the new coin commitment.
 * @param recipient The recipient public key or contract address.
 * @return The newly minted `ShieldedCoinInfo`.
 */
export circuit mintShieldedToken(
  domain_sep: Bytes<32>,
  value: Uint<64>,
  nonce: Bytes<32>,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>
): ShieldedCoinInfo {
  const coin = ShieldedCoinInfo { nonce: nonce, color: tokenType(domain_sep, kernel.self()), value: value };
  kernel.mintShielded(domain_sep, value);
  createZswapOutput(coin, recipient);
  const cm = coinCommitment(coin, recipient);
  kernel.claimZswapCoinSpend(cm);
  // Auto-receive when minting to self
  if (!recipient.is_left && recipient.right.bytes == kernel.self().bytes) {
    kernel.claimZswapCoinReceive(cm);
  }
  return coin;
}

/**
 * Computes the next deterministic nonce evolution using transient hash chaining.
 *
 * @param index Sequence index for nonce evolution.
 * @param nonce Current base nonce.
 * @return Evolved 32-byte nonce.
 */
export circuit evolveNonce(index: Uint<128>, nonce: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<Vector<3, Field>>([
    "midnight:kernel:nonce_evolve" as Field,
    index as Field,
    degradeToTransient(nonce),
  ]));
}

/**
 * Returns the canonical unspendable burn address for destroying shielded tokens.
 *
 * @return The burn address representation.
 */
export circuit shieldedBurnAddress(): Either<ZswapCoinPublicKey, ContractAddress> {
  return left<ZswapCoinPublicKey, ContractAddress>(default<ZswapCoinPublicKey>);
}

/**
 * Claims receipt of an incoming shielded coin directed to this contract instance.
 *
 * @param coin The coin info received.
 */
export circuit receiveShielded(coin: ShieldedCoinInfo): [] {
  const recipient = right<ZswapCoinPublicKey, ContractAddress>(kernel.self());
  createZswapOutput(coin, recipient);
  kernel.claimZswapCoinReceive(coinCommitment(coin, recipient));
}

/**
 * Spends a qualified shielded coin and produces a new output coin with optional change.
 *
 * @param input The coin being spent.
 * @param recipient The recipient's public key or contract address.
 * @param value Amount to transfer.
 * @return A `ShieldedSendResult` containing the transfer output and any returned change.
 */
export circuit sendShielded(
  input: QualifiedShieldedCoinInfo,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  value: Uint<128>
): ShieldedSendResult {
  const selfAddr = kernel.self();
  createZswapInput(input);
  kernel.claimZswapNullifier(coinNullifier(downcastQualifiedCoin(input), selfAddr));
  const change = input.value - value;
  const output = ShieldedCoinInfo{
                   nonce: upgradeFromTransient(transientHash<Vector<2, Field>>(["midnight:kernel:nonce_evolve" as Field, degradeToTransient(input.nonce)])),
                   color: input.color,
                   value: value
                 };
  createZswapOutput(output, recipient);
  kernel.claimZswapCoinSpend(coinCommitment(output, recipient));

  // Auto-receive when sending to self
  if (!recipient.is_left && recipient.right.bytes == selfAddr.bytes) {
    kernel.claimZswapCoinReceive(coinCommitment(output, recipient));
  }

  if (change == 0) {
    return ShieldedSendResult{ change: none<ShieldedCoinInfo>(), sent: output };
  } else {
    const changeCoin = ShieldedCoinInfo{
                         nonce: upgradeFromTransient(transientHash<Vector<2, Field>>(["midnight:kernel:nonce_evolve/2" as Field, degradeToTransient(input.nonce)])),
                         color: input.color,
                         value: change
                       };
    createZswapOutput(changeCoin, right<ZswapCoinPublicKey, ContractAddress>(selfAddr));
    const cm = coinCommitment(changeCoin, right<ZswapCoinPublicKey, ContractAddress>(selfAddr));
    kernel.claimZswapCoinSpend(cm);
    kernel.claimZswapCoinReceive(cm);
    return ShieldedSendResult{ change: some<ShieldedCoinInfo>(changeCoin), sent: output };
  }
}

/**
 * Sends a shielded coin directly to a recipient without waiting for on-chain spend qualification.
 *
 * @param input The coin being transferred.
 * @param target The recipient destination.
 * @param value Amount to transfer.
 * @return A `ShieldedSendResult` containing the transfer output.
 */
export circuit sendImmediateShielded(
  input: ShieldedCoinInfo,
  target: Either<ZswapCoinPublicKey, ContractAddress>,
  value: Uint<128>
): ShieldedSendResult {
  return sendShielded(upcastQualifiedCoin(input), target, value);
}

/**
 * Merges two qualified shielded coins of the same asset color into a single output coin.
 *
 * @param a First coin to merge.
 * @param b Second coin to merge.
 * @return The merged `ShieldedCoinInfo`.
 */
export circuit mergeCoin(
  a: QualifiedShieldedCoinInfo,
  b: QualifiedShieldedCoinInfo
): ShieldedCoinInfo {
  const selfAddr = kernel.self();
  createZswapInput(a);
  kernel.claimZswapNullifier(coinNullifier(downcastQualifiedCoin(a), selfAddr));
  createZswapInput(b);
  kernel.claimZswapNullifier(coinNullifier(downcastQualifiedCoin(b), selfAddr));
  assert(a.color == b.color, "Can only merge coins of the same color");
  const newCoin = ShieldedCoinInfo{
                     nonce: upgradeFromTransient(transientHash<Vector<2, Field>>(["midnight:kernel:nonce_evolve" as Field, degradeToTransient(a.nonce)])),
                     color: a.color,
                     value: (a.value + b.value) as Uint<128>
                   };
  createZswapOutput(newCoin, right<ZswapCoinPublicKey, ContractAddress>(selfAddr));
  const cm = coinCommitment(newCoin, right<ZswapCoinPublicKey, ContractAddress>(selfAddr));
  kernel.claimZswapCoinSpend(cm);
  kernel.claimZswapCoinReceive(cm);
  return newCoin;
}

/**
 * Merges a qualified shielded coin and an immediate shielded coin of the same asset color.
 *
 * @param a Qualified coin.
 * @param b Immediate coin.
 * @return The merged `ShieldedCoinInfo`.
 */
export circuit mergeCoinImmediate(
  a: QualifiedShieldedCoinInfo,
  b: ShieldedCoinInfo
): ShieldedCoinInfo {
  return mergeCoin(a, upcastQualifiedCoin(b));
}

circuit downcastQualifiedCoin(coin: QualifiedShieldedCoinInfo): ShieldedCoinInfo {
  return ShieldedCoinInfo{ nonce: coin.nonce, color: coin.color, value: coin.value };
}

circuit upcastQualifiedCoin(coin: ShieldedCoinInfo): QualifiedShieldedCoinInfo {
  return QualifiedShieldedCoinInfo{ nonce: coin.nonce, color: coin.color, value: coin.value, mt_index: 0 };
}

struct CoinPreimage {
  // `midnight:zswap-cc[v1]` / `midnight:zswap-cn[v1]`
  domain_sep: Bytes<21>,
  info: ShieldedCoinInfo,
  dataType: Boolean,
  data: Bytes<32>,
}

circuit coinCommitment(
  coin: ShieldedCoinInfo,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>
): Bytes<32> {
  return persistentHash<CoinPreimage>(
    CoinPreimage{
      domain_sep: "midnight:zswap-cc[v1]",
      info: coin,
      dataType: recipient.is_left,
      data: recipient.is_left ? recipient.left.bytes : recipient.right.bytes,
    });
}

circuit coinNullifier(
  coin: ShieldedCoinInfo,
  addr: ContractAddress
): Bytes<32> {
  return persistentHash<CoinPreimage>(
    CoinPreimage{
      domain_sep: "midnight:zswap-cn[v1]",
      info: coin,
      dataType: false, // The hypothetical is_left of Either<ZSwapCoinSecretKey, ContractAddress>
      data: addr.bytes,
    });
}

/**
 * Asserts whether the current block timestamp is strictly less than the given time.
 *
 * @param time The threshold timestamp to compare against.
 * @return True if current block time is less than `time`.
 */
export circuit blockTimeLt(time: Uint<64>): Boolean {
  return kernel.blockTimeLessThan(time);
}

/**
 * Asserts whether the current block timestamp is greater than or equal to the given time.
 *
 * @param time The threshold timestamp to compare against.
 * @return True if current block time is greater than or equal to `time`.
 */
export circuit blockTimeGte(time: Uint<64>): Boolean {
  return !blockTimeLt(time);
}

/**
 * Asserts whether the current block timestamp is strictly greater than the given time.
 *
 * @param time The threshold timestamp to compare against.
 * @return True if current block time is greater than `time`.
 */
export circuit blockTimeGt(time: Uint<64>): Boolean {
  return kernel.blockTimeGreaterThan(time);
}

/**
 * Asserts whether the current block timestamp is less than or equal to the given time.
 *
 * @param time The threshold timestamp to compare against.
 * @return True if current block time is less than or equal to `time`.
 */
export circuit blockTimeLte(time: Uint<64>): Boolean {
  return !blockTimeGt(time);
}

// =========================================================================
// Utilities for unshielded tokens
// =========================================================================

/**
 * Public address of a standard Midnight account or user wallet.
 *
 * @param bytes 32-byte public key representation of the user address.
 */
export struct UserAddress { bytes: Bytes<32>; }

/**
 * Mints an unshielded token and credits it to the specified contract or user address.
 *
 * @param domainSep Domain separation identifier for the token.
 * @param amount Number of tokens to mint.
 * @param recipient Destination contract or user address.
 * @return 32-byte color identifier for the minted token.
 */
export circuit mintUnshieldedToken(
  domainSep: Bytes<32>,
  amount: Uint<64>,
  recipient: Either<ContractAddress, UserAddress>
): Bytes<32> {
  kernel.mintUnshielded(domainSep, amount);
  const color = tokenType(domainSep, kernel.self());
  kernel.claimUnshieldedCoinSpend(left<Bytes<32>, Bytes<32>>(color), recipient, amount);
  // Auto-receive when minting to self
  if (recipient.is_left && recipient.left.bytes == kernel.self().bytes) {
    kernel.incUnshieldedInputs(left<Bytes<32>, Bytes<32>>(color), amount);
  }
  return color;
}

/**
 * Transfers unshielded tokens from this contract to another contract or user address.
 *
 * @param color 32-byte token identifier.
 * @param amount Number of tokens to transfer.
 * @param recipient Destination contract or user address.
 */
export circuit sendUnshielded(color: Bytes<32>, amount: Uint<128>, recipient: Either<ContractAddress, UserAddress>): [] {
  kernel.incUnshieldedOutputs(left<Bytes<32>, Bytes<32>>(color), amount);
  kernel.claimUnshieldedCoinSpend(left<Bytes<32>, Bytes<32>>(color), recipient, amount);
  // Auto-receive when sending to self
  if (recipient.is_left && recipient.left.bytes == kernel.self().bytes) {
    kernel.incUnshieldedInputs(left<Bytes<32>, Bytes<32>>(color), amount);
  }
}

/**
 * Claims incoming unshielded tokens transferred to this contract.
 *
 * @param color 32-byte token identifier.
 * @param amount Number of tokens received.
 */
export circuit receiveUnshielded(color: Bytes<32>, amount: Uint<128>): [] {
  kernel.incUnshieldedInputs(left<Bytes<32>, Bytes<32>>(color), amount);
}

/**
 * Returns the unshielded token balance of this contract for the given asset color.
 *
 * Note: The balance returned is the balance at transaction construction time.
 *
 * @param color 32-byte token color identifier.
 * @return Current balance as a 128-bit unsigned integer.
 */
export circuit unshieldedBalance(color: Bytes<32>): Uint<128> {
  return kernel.balance(left<Bytes<32>, Bytes<32>>(color));
}

/**
 * Checks whether the unshielded token balance is strictly less than the given amount.
 *
 * @param color 32-byte token color identifier.
 * @param amount Threshold amount to compare against.
 * @return True if balance is less than `amount`.
 */
export circuit unshieldedBalanceLt(color: Bytes<32>, amount: Uint<128>): Boolean {
  return kernel.balanceLessThan(left<Bytes<32>, Bytes<32>>(color), amount);
}

/**
 * Checks whether the unshielded token balance is greater than or equal to the given amount.
 *
 * @param color 32-byte token color identifier.
 * @param amount Threshold amount to compare against.
 * @return True if balance is greater than or equal to `amount`.
 */
export circuit unshieldedBalanceGte(color: Bytes<32>, amount: Uint<128>): Boolean {
  return !unshieldedBalanceLt(color, amount);
}

/**
 * Checks whether the unshielded token balance is strictly greater than the given amount.
 *
 * @param color 32-byte token color identifier.
 * @param amount Threshold amount to compare against.
 * @return True if balance is greater than `amount`.
 */
export circuit unshieldedBalanceGt(color: Bytes<32>, amount: Uint<128>): Boolean {
  return kernel.balanceGreaterThan(left<Bytes<32>, Bytes<32>>(color), amount);
}

/**
 * Checks whether the unshielded token balance is less than or equal to the given amount.
 *
 * @param color 32-byte token color identifier.
 * @param amount Threshold amount to compare against.
 * @return True if balance is less than or equal to `amount`.
 */
export circuit unshieldedBalanceLte(color: Bytes<32>, amount: Uint<128>): Boolean {
  return !unshieldedBalanceGt(color, amount);
}

// =========================================================================
// Schnorr signature
// =========================================================================

/**
 * Schnorr digital signature over the Jubjub embedded elliptic curve.
 *
 * @param announcement Point on the Jubjub curve representing the signature commitment.
 * @param response Scalar value in the Jubjub field satisfying the Schnorr equation.
 */
export struct JubjubSchnorrSignature {
  announcement: JubjubPoint,
  response: Field,
}

struct JubjubSchnorrHashInput<#N> {
  annX: Field,
  annY: Field,
  pkX: Field,
  pkY: Field,
  msg: Vector<N, Field>
}

/**
 * Verifies a Jubjub Schnorr digital signature over a message vector of size #N.
 *
 * @param msg Vector of field elements containing the signed message.
 * @param signature The Schnorr signature (announcement and response).
 * @param pk Public key point on the Jubjub curve.
 * @return True if the signature is valid, false otherwise.
 */
export circuit jubjubSchnorrVerify<#N>(
                 msg: Vector<N, Field>,
                 signature: JubjubSchnorrSignature,
                 pk: JubjubPoint
                 ): Boolean {
  const announcement = signature.announcement;
  const response = signature.response;
  const cNative = transientHash<JubjubSchnorrHashInput<N>>(
                    JubjubSchnorrHashInput<N> { annX: jubjubPointX(announcement),
                                                annY: jubjubPointY(announcement),
                                                pkX: jubjubPointX(pk),
                                                pkY: jubjubPointY(pk),
                                                msg: msg }
                    );
  const c = cNative as JubjubScalar;

  const lhs = ecMulGenerator(response as JubjubScalar);
  const rhs = ecAdd(announcement, ecMul(pk, c));

  return lhs == rhs;
}
