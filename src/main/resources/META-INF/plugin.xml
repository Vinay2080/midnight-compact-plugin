<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin url="https://github.com/Vinay2080/midnight-plugin">
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>dev.verloren.midnight</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Midnight Compact Language</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="shaking.121@gmail.com" url="https://github.com/Vinay2080">Verloren</vendor>

    <!-- A description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>First-class development support for the <b>Compact</b> smart contract language on the <b>Midnight</b> blockchain.</p>

        <p>This plugin equips IntelliJ IDEA with a comprehensive developer environment for writing, analyzing, navigating, and compiling zero-knowledge (ZK) smart contracts in Compact.</p>

        <h3>✨ Features</h3>
        <ul>
            <li><b>Syntax Highlighting &amp; Formatting:</b> Rich semantic token coloring, code formatting, smart indentation, brace matching, and code folding.</li>
            <li><b>Intelligent Code Completion:</b> Context-aware completion for keywords, built-in types, circuits, witnesses, exports, ledger state, and local bindings.</li>
            <li><b>Code Navigation &amp; Find Usages:</b> Go to Declaration (<code>Ctrl+B</code> / <code>Cmd+B</code>), Go to Symbol, and Find Usages across files with split VALUE/TYPE namespaces.</li>
            <li><b>Real-Time Inspections &amp; Quick-Fixes:</b>
                <ul>
                    <li>Type mismatch detection</li>
                    <li>Unresolved reference &amp; duplicate declaration checks</li>
                    <li>Pure circuit mutation &amp; sealed field validations</li>
                    <li>Recursive circuit detection &amp; undisclosed witness warnings</li>
                    <li>Unused local variable highlighting with quick-fixes</li>
                </ul>
            </li>
            <li><b>Structure View &amp; Breadcrumbs:</b> Visual outline view of contracts, circuits, witnesses, and type definitions.</li>
            <li><b>Quick Documentation &amp; Inlay Hints:</b> Hover documentation with inferred signatures and inline parameter name hints.</li>
            <li><b>Compiler &amp; Toolchain Integration:</b> Dedicated Run Configurations and gutter icons to build and verify Compact files using the <code>compact</code> compiler.</li>
            <li><b>Live Templates &amp; File Templates:</b> Pre-built templates for new Compact files and common smart contract patterns.</li>
        </ul>

        <h3>🚀 Getting Started</h3>
        <ol>
            <li>Install the plugin from the JetBrains Marketplace.</li>
            <li>Open or create any <code>.compact</code> file in your project.</li>
            <li>Configure your Compact compiler path under <b>Settings/Preferences &rarr; Languages &amp; Frameworks &rarr; Midnight Compact</b>.</li>
        </ol>

        <h3>🔗 Resources &amp; Links</h3>
        <ul>
            <li><a href="https://github.com/Vinay2080/midnight-plugin">GitHub Repository</a></li>
            <li><a href="https://github.com/Vinay2080/midnight-plugin/issues">Issue Tracker &amp; Bug Reports</a></li>
            <li><a href="https://docs.midnight.network/">Midnight Network Documentation</a></li>
        </ul>
    ]]></description>

    <!-- Change notes displayed in the IDE Plugin Manager "What's New" and Marketplace release history -->
    <change-notes><![CDATA[
        <h3>1.0.0</h3>
        <ul>
            <li>Initial release of Midnight Compact Language support for IntelliJ IDEA.</li>
            <li>Handwritten Lexer, Parser, and PSI support for Compact syntax.</li>
            <li>Code completion, reference resolution, and cross-file <code>include</code> resolution.</li>
            <li>9 semantic inspections with automated quick-fixes.</li>
            <li>Code formatting, smart indentation, structure view, and inlay parameter hints.</li>
            <li>Toolchain run configurations and gutter execution for the Compact compiler.</li>
            <li>File templates, live templates, breadcrumbs, and hover documentation.</li>
        </ul>
    ]]></change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

        <fileType
                name="Compact"
                language="Compact"
                extensions="compact"
                fieldName="INSTANCE"
                implementationClass="dev.verloren.midnight.CompactFileType"
        />
        <lang.parserDefinition
                language="Compact"
                implementationClass="dev.verloren.midnight.parser.CompactParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="Compact"
                implementationClass="dev.verloren.midnight.highlighter.CompactSyntaxHighlighterFactory"/>

        <annotator
                language="Compact"
                implementationClass="dev.verloren.midnight.highlighter.CompactHighlightingAnnotator"/>

        <colorSettingsPage
                implementation="dev.verloren.midnight.highlighter.CompactColorSettingsPage"/>

        <lang.findUsagesProvider
                language="Compact"
                implementationClass="dev.verloren.midnight.findUsages.CompactFindUsagesProvider"/>

        <lang.namesValidator
                language="Compact"
                implementationClass="dev.verloren.midnight.refactoring.CompactNamesValidator"/>

        <lang.refactoringSupport
                language="Compact"
                implementationClass="dev.verloren.midnight.refactoring.CompactRefactoringSupportProvider"/>

        <completion.contributor
                language="Compact"
                implementationClass="dev.verloren.midnight.completion.CompactCompletionContributor"/>

        <lang.formatter
                language="Compact"
                implementationClass="dev.verloren.midnight.formatter.CompactFormattingModelBuilder"/>

        <langCodeStyleSettingsProvider
                implementation="dev.verloren.midnight.formatter.CompactLanguageCodeStyleSettingsProvider"/>

        <lang.psiStructureViewFactory
                language="Compact"
                implementationClass="dev.verloren.midnight.structure.CompactStructureViewFactory"/>

        <lang.documentationProvider
                language="Compact"
                implementationClass="dev.verloren.midnight.documentation.CompactDocumentationProvider"/>

        <lang.commenter
                language="Compact"
                implementationClass="dev.verloren.midnight.editor.CompactCommenter"/>

        <lang.braceMatcher
                language="Compact"
                implementationClass="dev.verloren.midnight.editor.CompactPairedBraceMatcher"/>

        <lang.quoteHandler
                language="Compact"
                implementationClass="dev.verloren.midnight.editor.CompactQuoteHandler"/>

        <gotoClassContributor
                implementation="dev.verloren.midnight.navigation.CompactGotoClassContributor"/>

        <gotoSymbolContributor
                implementation="dev.verloren.midnight.navigation.CompactGotoSymbolContributor"/>

        <gotoDeclarationHandler
                implementation="dev.verloren.midnight.navigation.CompactGotoDeclarationHandler"/>

        <psi.referenceContributor
                language="Compact"
                implementation="dev.verloren.midnight.reference.CompactReferenceContributor"/>

        <configurationType
                implementation="dev.verloren.midnight.run.CompactConfigurationType"/>

        <runConfigurationProducer
                implementation="dev.verloren.midnight.run.CompactRunConfigurationProducer"/>

        <runLineMarkerContributor
                language="Compact"
                implementationClass="dev.verloren.midnight.run.CompactRunLineMarkerContributor"/>

        <applicationService
                serviceImplementation="dev.verloren.midnight.settings.MidnightSettingsState"/>

        <applicationConfigurable
                parentId="language"
                instance="dev.verloren.midnight.settings.MidnightSettingsConfigurable"
                id="dev.verloren.midnight.settings.MidnightSettingsConfigurable"
                displayName="Midnight Compact"/>

        <fileTemplateGroup
                implementation="dev.verloren.midnight.ide.fileTemplates.CompactFileTemplateGroupFactory"/>

        <defaultLiveTemplates
                file="/liveTemplates/Compact.xml"/>

        <liveTemplateContext
                contextId="COMPACT_CODE"
                implementation="dev.verloren.midnight.ide.templates.CompactLiveTemplateContextType"/>

        <lang.foldingBuilder
                language="Compact"
                implementationClass="dev.verloren.midnight.editor.CompactFoldingBuilder"/>

        <breadcrumbsInfoProvider
                implementation="dev.verloren.midnight.editor.CompactBreadcrumbsProvider"/>

        <spellchecker.support
                language="Compact"
                implementationClass="dev.verloren.midnight.editor.CompactSpellcheckingStrategy"/>

        <lang.surroundDescriptor
                language="Compact"
                implementationClass="dev.verloren.midnight.editor.CompactSurroundDescriptor"/>

        <codeInsight.parameterNameHints
                language="Compact"
                implementationClass="dev.verloren.midnight.editor.CompactInlayParameterHintsProvider"/>

        <externalAnnotator
                language="Compact"
                implementationClass="dev.verloren.midnight.annotator.CompactExternalAnnotator"/>

        <codeInsight.lineMarkerProvider
                language="Compact"
                implementationClass="dev.verloren.midnight.editor.CompactLineMarkerProvider"/>




        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactUnresolvedReference"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactUnresolvedReferenceInspection"
                key="inspection.compact.unresolved.reference.display.name"/>

        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactDuplicateDeclaration"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactDuplicateDeclarationInspection"
                key="inspection.compact.duplicate.declaration.display.name"/>

        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactUnusedLocalVariable"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactUnusedLocalVariableInspection"
                key="inspection.compact.unused.local.variable.display.name"/>

        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactTypeMismatch"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="dev.verloren.midnight.inspection.CompactTypeMismatchInspection"
                key="inspection.compact.type.mismatch.display.name"/>

        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactPureCircuit"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactPureCircuitInspection"
                key="inspection.compact.pure.circuit.display.name"/>

        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactSealedFieldMutation"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactSealedFieldMutationInspection"
                key="inspection.compact.sealed.field.mutation.display.name"/>

        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactRecursiveCircuit"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactRecursiveCircuitInspection"
                key="inspection.compact.recursive.circuit.display.name"/>

        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactConstructorRestriction"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactConstructorRestrictionInspection"
                key="inspection.compact.constructor.restriction.display.name"/>

        <localInspection
                language="Compact"
                groupKey="inspection.group.name.compact"
                shortName="CompactUndisclosedWitness"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactUndisclosedWitnessInspection"
                key="inspection.compact.undisclosed.witness.display.name"/>

    </extensions>

    <actions>
        <action
                id="dev.verloren.midnight.actions.CompactCreateFileAction"
                class="dev.verloren.midnight.actions.CompactCreateFileAction"
        >
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
    </actions>

</idea-plugin>
