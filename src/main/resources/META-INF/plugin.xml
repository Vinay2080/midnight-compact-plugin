<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>dev.verloren.midnight</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Midnight Language</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/Vinay2080">Verloren</vendor>

    <!-- A description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description>Midnight IntelliJ Plugin is an open-source IntelliJ IDEA plugin that brings first-class development
        support for the Compact programming language used by the Midnight blockchain. The plugin aims to provide syntax
        highlighting, code completion, inspections, formatting, navigation, compiler integration, and other IDE features
        to improve the developer experience for building Midnight smart contracts.
    </description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

        <fileType
                name="Compact"
                language="Compact"
                implementationClass="dev.verloren.midnight.CompactFileType"
        />
        <lang.parserDefinition
                language="Compact"
                implementationClass="dev.verloren.midnight.parser.CompactParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="Compact"
                implementationClass="dev.verloren.midnight.highlighter.CompactSyntaxHighlighterFactory"/>

        <lang.findUsagesProvider
                language="Compact"
                implementationClass="dev.verloren.midnight.findUsages.CompactFindUsagesProvider"/>

        <lang.namesValidator
                language="Compact"
                implementationClass="dev.verloren.midnight.refactoring.CompactNamesValidator"/>

        <lang.refactoringSupport
                language="Compact"
                implementationClass="dev.verloren.midnight.refactoring.CompactRefactoringSupportProvider"/>

        <completion.contributor
                language="Compact"
                implementationClass="dev.verloren.midnight.completion.CompactCompletionContributor"/>

        <lang.formatter
                language="Compact"
                implementationClass="dev.verloren.midnight.formatter.CompactFormattingModelBuilder"/>

        <langCodeStyleSettingsProvider
                implementation="dev.verloren.midnight.formatter.CompactLanguageCodeStyleSettingsProvider"/>

        <localInspection
                language="Compact"
                groupName="Compact"
                shortName="CompactUnresolvedReference"
                displayName="Unresolved reference"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactUnresolvedReferenceInspection"/>

        <localInspection
                language="Compact"
                groupName="Compact"
                shortName="CompactDuplicateDeclaration"
                displayName="Duplicate declaration"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactDuplicateDeclarationInspection"/>

        <localInspection
                language="Compact"
                groupName="Compact"
                shortName="CompactUnusedLocalVariable"
                displayName="Unused local variable"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactUnusedLocalVariableInspection"/>

        <localInspection
                language="Compact"
                groupName="Compact"
                shortName="CompactTypeMismatch"
                displayName="Type mismatch"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.verloren.midnight.inspection.CompactTypeMismatchInspection"/>

    </extensions>

</idea-plugin>
