<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Architectural Constraint: Max 400 lines per class file -->
    <module name="FileLength">
        <property name="max" value="400"/>
    </module>

    <!-- Suppressions Filter -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/checkstyle-suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <!-- AST TreeWalker checks -->
    <module name="TreeWalker">
        <!-- Structural Constraint: Max 40 lines per method in new components -->
        <module name="MethodLength">
            <property name="tokens" value="METHOD_DEF, CTOR_DEF, COMPACT_CTOR_DEF"/>
            <property name="max" value="40"/>
        </module>

        <!-- Package naming (allows IntelliJ camelCase packages e.g. findUsages, smartEnter) -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-zA-Z0-9]+)*$"/>
        </module>
    </module>
</module>
